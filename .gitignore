# ---------------------------------------------------------------------------
# Unreal Engine generated / derived data (regenerable — never commit)
# ---------------------------------------------------------------------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# Plugin-level generated output
Plugins/**/Binaries/
Plugins/**/Intermediate/

# ---------------------------------------------------------------------------
# IDE / project files (machine-specific, regenerated by GenerateProjectFiles)
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.VC.db
*.VC.opendb
*.sln
*.suo
*.xcodeproj/
*.xcworkspace/
*.sdf
*.opensdf

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
*.swp

# ---------------------------------------------------------------------------
# Large binary reference assets (exceed GitHub's 100 MB limit — keep locally)
# The GDC talk source video stays on disk but is not pushed. Its transcript,
# frames, and analysis notes under "Misc Resources/Analysis" ARE tracked.
# ---------------------------------------------------------------------------
Misc Resources/*.mp4
*.mp4
